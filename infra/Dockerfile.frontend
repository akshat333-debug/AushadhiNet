FROM node:20-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend .
# NEXT_PUBLIC_* values are inlined at build time. The browser, not the container, calls the API.
# Default targets the deployed backend so a cloud build needs no build-arg support;
# docker-compose passes the localhost value explicitly for local runs.
ARG NEXT_PUBLIC_API_BASE=https://aushadhinet-backend.onrender.com
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
RUN npx next build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
