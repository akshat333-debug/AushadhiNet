# Copy to .env and fill in. Never commit .env.
# AUSHADHI_MODE selects the provider implementation set (backend/providers/factory.py).
AUSHADHI_MODE=local                # local | cloud

# --- cloud mode only (leave as placeholders until GCP credits arrive) ---
GCP_PROJECT=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.0-flash
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number
FIRESTORE_EMULATOR_HOST=localhost:8080
BIGQUERY_PROJECT=REPLACE_ME
SIGNING_KEY=REPLACE_ME              # HMAC key in local mode; Cloud KMS key resource in cloud mode
MAPS_API_KEY=REPLACE_ME

# --- local mode ---
DUCKDB_PATH=:memory:                # a real path here makes local mode persist across runs; explicit opt-in

# --- shared thresholds (project.md NFRs) ---
CONFIDENCE_THRESHOLD=0.85
GEOFENCE_RADIUS_M=200
MAX_UPLOAD_MB=10
ALLOWED_MIME=image/jpeg,image/png,audio/ogg,audio/amr,audio/mpeg
ESCALATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BIGQUERY_DATASET=aushadhinet_mh
PUBSUB_PUSH_AUDIENCE=REPLACE_ME
PUBSUB_PUSH_SERVICE_ACCOUNT=REPLACE_ME
SERVED_STATES=maharashtra
SERVING_WEEKS=16
