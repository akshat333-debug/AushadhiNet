FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.*

# Locked dependencies first so code edits don't bust this layer. The gcp extra is included so the
# same image runs in local mode (compose) and cloud mode (Cloud Run).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra ml --extra gcp --no-dev

COPY backend ./backend
COPY ml ./ml
COPY eval ./eval
COPY data ./data

ENV PATH="/app/.venv/bin:$PATH"
# Build the sealed synthetic ledger into the image; the build fails if its hash differs from
# eval/protocol.lock, so no container can serve unsealed data and cold starts stay fast.
RUN python -m eval.seal_generator

ENV AUSHADHI_MODE=local PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn backend.app:app --host 0.0.0.0 --port ${PORT}"]
