FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY backend ./backend
COPY ml ./ml
COPY eval ./eval
COPY data/README.md data/raw_manifest.sha256 ./data/

RUN uv pip install --system --no-cache -e ".[ml,gcp]"

ENV AUSHADHI_MODE=local
EXPOSE 8000

CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
